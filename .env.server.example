# Copy to .env.server on each target server (dev, prod, or a local test box) and fill
# in real values. .env.server is gitignored - never commit the filled-in version.
# Used by: docker compose --env-file .env.server -f docker-compose.server.yml up -d

# AWS account/region the images are pulled from (ECR). 002429227764/ap-south-1 is the
# account foundry.django/deploy.sh and foundry.react's dockerize-fe.yml already push to -
# override only if this environment uses a different account.
# IMAGE_TAG_FE/IMAGE_TAG_BE are NOT set here - they're required env vars passed on the
# command line to `./manufapp.sh start`/`restart`, e.g.:
#   IMAGE_TAG_FE=1.39.0 IMAGE_TAG_BE=v1.39.0 ./manufapp.sh start
# so the image version being deployed is always an explicit, visible part of the command.
AWS_ACCOUNT_ID=002429227764
AWS_REGION=ap-south-1

# local | dev | production - controls Django settings branching (foundry/settings.py).
ENV_NAME=production

# Must match the DJANGO_SECRET_KEY the images were built expecting to see at runtime.
DJANGO_SECRET_KEY=replace-with-real-django-secret-key

# Postgres already installed on the host (not containerized) - host.docker.internal
# resolves to the host machine from inside the container via the compose file's
# extra_hosts entry.
DB_HOST=host.docker.internal
DB_NAME=manufapp
DB_USER=caretaker
DB_PASSWORD=replace-with-real-db-password
DB_PORT=5432

# Needed if this environment uses S3 (documents, audit logs, etc.). Leave both keys
# blank if the host already has a profile from `./manufapp.sh setup`'s `aws configure`
# step (or one you ran yourself) - docker-compose.server.yml mounts ~/.aws read-only
# into django/celery/celery-beat and points AWS_SHARED_CREDENTIALS_FILE/AWS_CONFIG_FILE
# at it, so that profile is used automatically. Only set these if you need a *different*
# identity than the host's own profile (e.g. a narrower-scoped S3-only key) - explicit
# keys here take priority over the mounted profile.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
# Only needed if the host's AWS CLI has more than one named profile and the one to use
# here isn't "default".
AWS_PROFILE=default
